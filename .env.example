# Supabase — ISP Account Management instance
VITE_SUPABASE_URL=https://hanktisgkhyikzfuowkp.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Fabric Console URL (for redirect-based login)
VITE_ACCOUNTS_URL=https://accounts.infinitespaces.ai

# Feature flags — set to "true" to enable, "false" to disable
VITE_SHOW_SOCIAL=false
VITE_SHOW_GALLERY=false
VITE_SHOW_DIRECTORY=false
VITE_SHOW_ARTICLES=false
VITE_SHOW_JOBS=false
VITE_SHOW_PRICING=false

# Waitlist mode — "true" redirects signup to /waitlist, "false" enables normal registration
VITE_WAITLIST_MODE=true
