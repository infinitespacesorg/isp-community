# Supabase — ISP Account Management instance
VITE_SUPABASE_URL=https://hanktisgkhyikzfuowkp.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Fabric Console URL (for redirect-based login)
VITE_ACCOUNTS_URL=https://accounts.infinitespaces.ai

# Feature flags — set to "true" to enable, "false" to disable
VITE_SHOW_SOCIAL=false
VITE_SHOW_GALLERY=false
VITE_SHOW_DIRECTORY=false
VITE_SHOW_ARTICLES=false
VITE_SHOW_JOBS=false
VITE_SHOW_PRICING=false

# Waitlist mode — "true" redirects signup to /waitlist, "false" enables normal registration
VITE_WAITLIST_MODE=true

# Community admin gate — the "Infinite Spaces Studio" space id. Owner/Admin/
# Operator members of this space are community website admins (see useStudioRole).
# Mirrors community_settings.studio_space_id in the DB (migration 00038).
VITE_STUDIO_SPACE_ID=59a72a37-5302-41e6-8366-0b9d0a638b75

# bolt-keystatic (blog authoring). Repo the editor commits to:
VITE_KEYSTATIC_REPO=infinitespacesorg/isp-community
# Server-side only (Cloudflare Pages env, NOT committed) — GitHub App for the
# Keystatic editor's OAuth token exchange:
# KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=
# KEYSTATIC_SECRET=
